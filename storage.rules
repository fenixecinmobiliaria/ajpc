rules_version = '2';

// Reglas de Storage para jpcelectronics-52996.
// Las fotos son públicas para leer; solo el administrador sube o borra,
// y solo dentro de productos/, imágenes de hasta 10 MB.
service firebase.storage {
  match /b/{bucket}/o {

    function esAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/User/$(request.auth.uid)).data.rol == 'admin';
    }

    match /productos/{archivo} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if esAdmin();
    }

    // Archivos antiguos fuera de productos/: se pueden ver, no tocar desde la web.
    match /{rutaCualquiera=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
